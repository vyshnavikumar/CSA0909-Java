import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        String patientId;
        int department, doctor, slot;

        String[] departments = {
            "Cardiology",
            "Neurology",
            "Orthopedics"
        };

        String[][] doctors = {
            {"Dr. Ravi", "Dr. Kumar"},
            {"Dr. Priya", "Dr. Anil"},
            {"Dr. Suresh", "Dr. Meena"}
        };

        String[] slots = {
            "10:00 AM",
            "12:00 PM",
            "02:00 PM"
        };

        System.out.println("================================");
        System.out.println("   HOSPITAL APPOINTMENT DESK");
        System.out.println("================================");

        System.out.print("Enter Patient ID: ");
        patientId = sc.nextLine();

        if (patientId.trim().isEmpty()) {
            System.out.println("Error: Patient ID is required!");
            sc.close();
            return;
        }

        System.out.println("\nSelect Department:");

        for (int i = 0; i < departments.length; i++) {
            System.out.println((i + 1) + ". " + departments[i]);
        }

        System.out.print("Enter choice: ");
        department = sc.nextInt();

        if (department < 1 || department > 3) {
            System.out.println("Invalid department selection!");
            sc.close();
            return;
        }

        System.out.println("\nAvailable Doctors:");

        for (int i = 0; i < doctors[department - 1].length; i++) {
            System.out.println((i + 1) + ". "
                    + doctors[department - 1][i]);
        }

        System.out.print("Select Doctor: ");
        doctor = sc.nextInt();

        if (doctor < 1 || doctor > 2) {
            System.out.println("Invalid doctor selection!");
            sc.close();
            return;
        }

        System.out.println("\nAvailable Time Slots:");

        for (int i = 0; i < slots.length; i++) {
            System.out.println((i + 1) + ". " + slots[i]);
        }

        System.out.print("Select Time Slot: ");
        slot = sc.nextInt();

        if (slot < 1 || slot > 3) {
            System.out.println("Invalid time slot!");
            sc.close();
            return;
        }

        System.out.println("\n================================");
        System.out.println(" APPOINTMENT BOOKED SUCCESSFULLY");
        System.out.println("================================");

        System.out.println("Patient ID: " + patientId);
        System.out.println("Department: " + departments[department - 1]);
        System.out.println("Doctor: " + doctors[department - 1][doctor - 1]);
        System.out.println("Appointment Time: " + slots[slot - 1]);

        System.out.println("================================");

        sc.close();
    }
}
