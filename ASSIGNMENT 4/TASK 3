mport java.util.Scanner;
                        System.out.println("\nNext Page:");
                        displayBooks(titles, categories, currentPage, pageSize);
                    }
                    break;

                case 3:
                    if (currentPage > 0) {
                        currentPage--;
                        System.out.println("\nPrevious Page:");
                        displayBooks(titles, categories, currentPage, pageSize);
