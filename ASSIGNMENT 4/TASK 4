
import java.util.ArrayList;
import java.util.Scanner;

class Point {
    int x, y;

    Point(int x, int y) {
        this.x = x;
        this.y = y;
    }
}

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        ArrayList<Point> points = new ArrayList<>();

        int choice;

        System.out.println("================================");
        System.out.println("       JAVA DRAW PAD");
        System.out.println("================================");

        do {
            System.out.println("\n1. Add Drawing Point");
            System.out.println("2. Display Drawing Points");
            System.out.println("3. Clear Drawing");
            System.out.println("4. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.print("Enter X coordinate: ");
                    int x = sc.nextInt();

                    System.out.print("Enter Y coordinate: ");
                    int y = sc.nextInt();

                    points.add(new Point(x, y));

                    System.out.println("Point added successfully!");
                    break;

                case 2:
                    if (points.isEmpty()) {
                        System.out.println("No drawing points available!");
                    } else {
                        System.out.println("\nDrawing Points:");

                        for (int i = 0; i < points.size(); i++) {
                            Point p = points.get(i);

                            System.out.println(
                                "Point " + (i + 1) +
                                " : X = " + p.x +
                                ", Y = " + p.y
                            );
                        }
                    }
                    break;

                case 3:
                    points.clear();
                    System.out.println("Drawing cleared successfully!");
                    break;

                case 4:
                    System.out.println("Exiting Draw Pad...");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 4);

        sc.close();
    }
}
