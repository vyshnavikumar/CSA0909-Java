
import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        double amount, result;
        int choice;

        System.out.println("================================");
        System.out.println("       CURRENCY CONVERTER");
        System.out.println("================================");

        System.out.print("Enter amount in INR: ");
        amount = sc.nextDouble();

        if (amount < 0) {
            System.out.println("Invalid amount!");
            sc.close();
            return;
        }

        System.out.println("\nSelect Currency:");
        System.out.println("1. INR to USD");
        System.out.println("2. INR to EUR");
        System.out.println("3. INR to GBP");
        System.out.println("4. INR to AED");

        System.out.print("Enter your choice: ");
        choice = sc.nextInt();

        switch (choice) {

            case 1:
                result = amount / 88.50;
                System.out.println("\nConverted Amount: " + result + " USD");
                break;

            case 2:
                result = amount / 102.00;
                System.out.println("\nConverted Amount: " + result + " EUR");
                break;

            case 3:
                result = amount / 116.00;
                System.out.println("\nConverted Amount: " + result + " GBP");
                break;

            case 4:
                result = amount / 24.10;
                System.out.println("\nConverted Amount: " + result + " AED");
                break;

            default:
                System.out.println("Invalid currency selection!");
        }

        System.out.println("\nThank you for using Currency Converter!");

        sc.close();
    }
}
