
import java.util.*;

public class Main {

    static class Patient {
        String name;
        int severity;
        long arrival;

        Patient(String name, int severity, long arrival) {
            this.name = name;
            this.severity = severity;
            this.arrival = arrival;
        }

        public String toString() {
            return name + "(S" + severity + ")";
        }
    }

    static class Triage {

        long counter = 0;

        PriorityQueue<Patient> queue =
            new PriorityQueue<>(
                Comparator.comparingInt(
                    (Patient p) -> p.severity
                ).thenComparingLong(p -> p.arrival)
            );

        void admit(String name, int severity) {
            queue.add(new Patient(name, severity, counter++));
        }

        Patient next() {
            return queue.poll();
        }

        void displayWaitingList() {
            PriorityQueue<Patient> copy =
                new PriorityQueue<>(queue);

            System.out.println("Waiting List:");

            while (!copy.isEmpty()) {
                System.out.print(copy.poll() + " ");
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        Triage er = new Triage();

        // Adding patients
        er.admit("Ravi", 3);
        er.admit("Meena", 1);
        er.admit("John", 3);
        er.admit("Asha", 5);
        er.admit("Kumar", 1);
        er.admit("Lata", 2);
        er.admit("Priya", 4);
        er.admit("Arun", 2);

        // Display waiting list
        er.displayWaitingList();

        // Serving patients
        System.out.println("\nPATIENT TREATMENT ORDER:");

        Patient p;

        while ((p = er.next()) != null) {
            System.out.print(p + " ");
        }

        System.out.println();
    }
}
