
import java.util.*;

public class Main {

    static class Patient {
        String name;
        int severity;
        long arrival;

        Patient(String name, int severity, long arrival) {
            this.name = name;
            this.severity = severity;
            this.arrival = arrival;
        }

        public String toString() {
            return name + "(S" + severity + ")";
        }
    }

    // Original PriorityQueue implementation
    static class OriginalTriage {

        long counter = 0;

        PriorityQueue<Patient> queue =
            new PriorityQueue<>(
                Comparator.comparingInt(
                    (Patient p) -> p.severity
                ).thenComparingLong(p -> p.arrival)
            );

        void admit(String name, int severity) {
            queue.add(new Patient(name, severity, counter++));
        }

        Patient next() {
            return queue.poll();
        }
    }

    // Redesigned implementation using five FIFO queues
    static class ImprovedTriage {

        ArrayList<ArrayDeque<Patient>> queues =
            new ArrayList<>();

        long counter = 0;

        ImprovedTriage() {
            for (int i = 0; i < 5; i++) {
                queues.add(new ArrayDeque<>());
            }
        }

        void admit(String name, int severity) {

            if (severity < 1 || severity > 5) {
                throw new IllegalArgumentException(
                    "Severity must be between 1 and 5"
                );
            }

            Patient p = new Patient(
                name, severity, counter++
            );

            queues.get(severity - 1).offer(p);
        }

        Patient next() {

            // Check severity from 1 to 5
            for (int i = 0; i < 5; i++) {

                if (!queues.get(i).isEmpty()) {
                    return queues.get(i).poll();
                }
            }

            return null;
        }
    }

    public static void main(String[] args) {

        OriginalTriage original = new OriginalTriage();

        ImprovedTriage improved = new ImprovedTriage();

        String[] names = {
            "Ravi", "Meena", "John", "Asha",
            "Kumar", "Lata", "Priya", "Arun"
        };

        int[] severity = {
            3, 1, 3, 5, 1, 2, 4, 2
        };

        System.out.println("ORIGINAL PRIORITY QUEUE:");

        for (int i = 0; i < names.length; i++) {
            original.admit(names[i], severity[i]);
        }

        Patient p;

        while ((p = original.next()) != null) {
            System.out.print(p + " ");
        }

        System.out.println("\n");

        System.out.println("REDESIGNED FIFO QUEUES:");

        for (int i = 0; i < names.length; i++) {
            improved.admit(names[i], severity[i]);
        }

        while ((p = improved.next()) != null) {
            System.out.print(p + " ");
        }

        System.out.println("\n");

        // Performance comparison
        int[] sizes = {1000, 10000, 50000};

        System.out.println("PERFORMANCE COMPARISON");

        for (int size : sizes) {

            long start1 = System.nanoTime();

            OriginalTriage o = new OriginalTriage();

            for (int i = 0; i < size; i++) {
                o.admit("Patient" + i, (i % 5) + 1);
            }

            while (o.next() != null) {
                // Remove all patients
            }

            long end1 = System.nanoTime();

            long start2 = System.nanoTime();

            ImprovedTriage r = new ImprovedTriage();

            for (int i = 0; i < size; i++) {
                r.admit("Patient" + i, (i % 5) + 1);
            }

            while (r.next() != null) {
                // Remove all patients
            }

            long end2 = System.nanoTime();

            System.out.println("\nPatients: " + size);

            System.out.println(
                "PriorityQueue: " +
                (end1 - start1) / 1000000.0 + " ms"
            );

            System.out.println(
                "Five FIFO Queues: " +
                (end2 - start2) / 1000000.0 + " ms"
            );
        }
    }
}
