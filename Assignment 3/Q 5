
class ScannerStation extends Thread {

    ScannerStation(String name) {
        super(name);
    }

    public void run() {
        System.out.println(getName() + " started");

        for (int i = 1; i <= 3; i++) {
            System.out.println(getName() + " scanning script " + i);

            try {
                Thread.sleep(300);
            } catch (InterruptedException e) {
                System.out.println(getName() + " interrupted");
            }
        }

        System.out.println(getName() + " completed");
    }
}

public class Main {

    public static void main(String[] args) {

        for (int run = 1; run <= 10; run++) {

            System.out.println("\nRUN " + run);

            ScannerStation s1 = new ScannerStation("Station 1");
            ScannerStation s2 = new ScannerStation("Station 2");
            ScannerStation s3 = new ScannerStation("Station 3");
            ScannerStation s4 = new ScannerStation("Station 4");

            // Set thread priorities
            s1.setPriority(Thread.MAX_PRIORITY);
            s2.setPriority(Thread.NORM_PRIORITY);
            s3.setPriority(Thread.MIN_PRIORITY);
            s4.setPriority(Thread.NORM_PRIORITY);

            // Make Station 4 a daemon thread
            s4.setDaemon(true);

            // Start all threads
            s1.start();
            s2.start();
            s3.start();
            s4.start();

            try {
                s1.join();
                s2.join();
                s3.join();
            } catch (InterruptedException e) {
                System.out.println("Main thread interrupted");
            }

            System.out.println("Main thread completed run " + run);
        }
    }
}
