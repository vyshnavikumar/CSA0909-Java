
import java.util.Scanner;
import java.io.File;
import java.io.FileNotFoundException;

class InsufficientBalanceException extends Exception {
    InsufficientBalanceException(String message) {
        super(message);
    }
}

public class ATMStudentB {

    static void withdraw(String account, String amount)
            throws InsufficientBalanceException,
                   FileNotFoundException {

        try {
            int acc = Integer.parseInt(account);
            double money = Double.parseDouble(amount);

            if (acc <= 0)
                throw new IllegalArgumentException("Invalid account number");

            if (money < 0)
                throw new IllegalArgumentException("Negative withdrawal");

            if (money == 0)
                throw new IllegalArgumentException("Amount cannot be zero");

            if (money > 10000)
                throw new InsufficientBalanceException(
                    "Insufficient balance");

            File file = new File("cardreader.txt");

            if (!file.exists())
                throw new FileNotFoundException(
                    "Card reader file is missing");

            System.out.println("Withdrawal successful: Rs." + money);

        } catch (NumberFormatException e) {
            System.out.println("Catch: Invalid numeric input");

        } catch (IllegalArgumentException e) {
            System.out.println("Catch: " + e.getMessage());

        } catch (InsufficientBalanceException e) {
            System.out.println("Catch: " + e.getMessage());

        } catch (FileNotFoundException e) {
            System.out.println("Catch: " + e.getMessage());

        } finally {
            System.out.println("Finally: ATM transaction completed");
        }
    }

    public static void main(String[] args) {

        String[][] tests = {
            {"101", "500"},
            {"ABC", "500"},
            {"102", "-200"},
            {"103", "15000"},
            {"104", "1000"}
        };

        for (int i = 0; i < tests.length; i++) {
            System.out.println("\nTest " + (i + 1));

            try {
                withdraw(tests[i][0], tests[i][1]);
            } catch (Exception e) {
                System.out.println("Outer catch: " + e.getMessage());
            }
        }
    }
}
